# PIMS environment configuration template.
# Copy to .env and fill values. Never commit .env.

# --- Application ---
PIMS_ENVIRONMENT=development
PIMS_LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
PIMS_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pims

# --- Market Data Providers ---
# Crypto provider adapter: BYBIT or YAHOO.
PIMS_CRYPTO_PROVIDER=YAHOO
PIMS_BYBIT_BASE_URL=https://api.bybit.com
PIMS_BYBIT_API_KEY=
PIMS_BYBIT_API_SECRET=
PIMS_YAHOO_BASE_URL=https://query1.finance.yahoo.com

# --- AI Research (OpenAI-compatible endpoint: OpenAI, OpenRouter, Groq, etc.) ---
# Leave empty to run research requests without report generation.
PIMS_LLM_BASE_URL=
PIMS_LLM_API_KEY=
PIMS_LLM_MODEL=
